# Gabarit des variables d'environnement — À COPIER, jamais à remplir ici.
# Aucune valeur réelle ne doit être versionnée. Voir DEPLOYMENT.md.
#
#   Local  : copier en `.env` et renseigner DATABASE_URL (Postgres local).
#   Vercel : définir ces variables dans Project Settings → Environment Variables.

# Connexion Postgres. En production : la chaîne fournie par l'hébergeur (Neon/Vercel
# Postgres…), avec SSL. Ne jamais committer la vraie valeur.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret de session Auth.js (JWT). Générer une valeur ALÉATOIRE unique par
# environnement :  openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-valeur-aleatoire"

# Compte de démonstration (production uniquement). Le seed ne crée ce compte QUE si
# DEMO_SYNDIC_PASSWORD est défini (≥ 12 caractères). Générer un mot de passe long et
# aléatoire (jamais celui de développement) :  openssl rand -base64 24
# À définir dans Vercel, puis lancer le seed une fois contre la base de production.
DEMO_SYNDIC_EMAIL="demo@syndici.ma"
DEMO_SYNDIC_PASSWORD="remplacer-par-un-mot-de-passe-long-et-aleatoire"
