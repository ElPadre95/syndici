# Gabarit des variables d'environnement — À COPIER, jamais à remplir ici.
# Aucune valeur réelle ne doit être versionnée. Voir DEPLOYMENT.md.
#
#   Local  : copier en `.env` et renseigner DATABASE_URL (Postgres local).
#   Vercel : définir ces variables dans Project Settings → Environment Variables.

# Connexion Postgres — l'application (runtime). Sur Neon : la chaîne POOLÉE
# (l'hôte contient `-pooler`). En local : Postgres direct. Avec SSL en prod.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# Connexion DIRECTE (sans pooler) — utilisée UNIQUEMENT par `prisma migrate`
# (le pooler transactionnel casse les migrations). Sur Neon : l'URL SANS `-pooler`.
# En local : identique à DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret de session Auth.js (JWT). Générer une valeur ALÉATOIRE unique par
# environnement :  openssl rand -base64 32
AUTH_SECRET="remplacer-par-une-valeur-aleatoire"

# Compte de démonstration (production uniquement). Le seed ne crée ce compte QUE si
# DEMO_SYNDIC_PASSWORD est défini (≥ 12 caractères). Générer un mot de passe long et
# aléatoire (jamais celui de développement) :  openssl rand -base64 24
# À définir dans Vercel, puis lancer le seed une fois contre la base de production.
DEMO_SYNDIC_EMAIL="demo@syndici.ma"
DEMO_SYNDIC_PASSWORD="remplacer-par-un-mot-de-passe-long-et-aleatoire"

# ── E-mails transactionnels (I5) — fournisseur Resend ──────────────────────────
# EN DÉVELOPPEMENT : ne rien définir. Sans RESEND_API_KEY (ou hors production), aucun
# e-mail ne part — tout est JOURNALISÉ (préfixe `[mail:dev]`). Voir DEPLOYMENT.md §Mail.
#
# Clé d'API Resend (Vercel, production). Tant qu'elle est absente, on journalise seulement.
RESEND_API_KEY=""
# Expéditeur. Défaut interne : "Syndici <onboarding@resend.dev>" (adresse de TEST Resend,
# fonctionne SANS domaine ni DNS). Le jour du vrai domaine : "Syndici <no-reply@ton-domaine>".
MAIL_FROM="Syndici <onboarding@resend.dev>"
# Phase interne : redirige TOUS les e-mails vers ton adresse vérifiée (rien ne part aux
# résidents). Le jour du vrai domaine : SUPPRIMER cette variable pour livrer aux vrais destinataires.
MAIL_REDIRECT_TO="ton-adresse-verifiee@exemple.com"
